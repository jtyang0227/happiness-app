{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "jenkins": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2",
        "jenkins-mcp"
      ],
      "env": {
        "JENKINS_URL": "${JENKINS_URL}",
        "JENKINS_USERNAME": "${JENKINS_USERNAME}",
        "JENKINS_PASSWORD": "${JENKINS_PASSWORD}",
        "JENKINS_USE_API_TOKEN": "${JENKINS_USE_API_TOKEN:-true}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "photoshop": {
      "command": "npx",
      "args": [
        "-y",
        "@alisaitteke/photoshop-mcp@1.7.38"
      ],
      "env": {
        "LOG_LEVEL": "1"
      }
    },
    "lightroom": {
      "command": "npx",
      "args": [
        "-y",
        "@mskalski/lightroom-mcp@0.27.0"
      ]
    },
    "cloudflare-api": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    }
  }
}
