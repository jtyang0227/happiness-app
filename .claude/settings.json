{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "mcp__claude_ai_Google_Drive__*",
      "mcp__Gmail__*",
      "mcp__jenkins__list_jobs",
      "mcp__jenkins__get_build_status"
    ],
    "ask": [
      "mcp__jenkins__trigger_build"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "msg=$(jq -r '.prompt // \"\"'); echo \"$msg\" | grep -q '기획' && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"[자동 트리거] 사용자가 기획을 요청했습니다. 반드시 /loop 스킬을 즉시 호출하여 다음 순서로 자동 수행하세요: 1) DESIGN_PROMPTS/ 하위에 기획 문서(DESIGN_PROMPT_<feature>.md) 작성 2) 백엔드 + 프론트엔드 구현 3) 디자인 작업(컴포넌트 UI 완성) 4) /verify로 런타임 검증 5) git commit + push 완료. /loop가 스스로 페이스를 조절하며 완료까지 반복합니다.\"}}' || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-frontend-file.sh\"",
            "timeout": 60,
            "statusMessage": "웹 소스 ESLint 확인 중..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"systemMessage\": \"\\u2705 커밋 완료 — 작업 브랜치에 push한 뒤 master는 fast-forward로만 올리세요 (강제 push 금지)\"}'",
            "if": "Bash(git commit *)",
            "statusMessage": "커밋 후 안내"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/notify-page-change.sh\"",
            "statusMessage": "화면 파일 변경 확인 중..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-md-management@happiness-app-plugins": true,
    "claude-code-setup@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "happiness-app-plugins": {
      "source": {
        "source": "directory",
        "path": "."
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  }
}
