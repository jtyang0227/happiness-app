# .mcp.json(MCP 서버)에서 참조하는 환경변수 — 이 파일을 .env로 복사해 실제 값을 채운다.
# .env는 커밋 금지(.gitignore에 포함). Claude Code는 .env를 자동으로 읽지 않으므로
# 셸에서 export 한 뒤 Claude Code를 실행한다:  set -a && source .env && set +a && claude

# GitHub MCP — Personal Access Token (무료, github.com/settings/personal-access-tokens)
# 권장: Fine-grained 토큰, 이 저장소만, Contents/Issues/Pull requests/Actions 읽기 권한
GITHUB_PERSONAL_ACCESS_TOKEN=

# Jenkins MCP — 비밀번호 대신 API 토큰 사용 (Jenkins › 사용자 › Security › API Token)
JENKINS_URL=https://jenkins.example.com
JENKINS_USERNAME=
JENKINS_PASSWORD=
JENKINS_USE_API_TOKEN=true
