{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": false,
    "allowJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "react-native-view-shot": [
        "./node_modules/react-native-view-shot/lib/index.d.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".expo",
    "babel.config.js"
  ]
}
