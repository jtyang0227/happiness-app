{
  "name": "happiness-api",
  "version": "0.1.0",
  "private": true,
  "description": "Happiness API (NestJS) — Spring Boot backend/를 단계별로 대체한다. DESIGN_PROMPTS/planning/PLANNING_typescript-migration.md",
  "scripts": {
    "build": "prisma generate && prisma generate --config prisma.admin.config.ts && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prisma:pull": "prisma db pull",
    "prisma:generate": "prisma generate && prisma generate --config prisma.admin.config.ts",
    "typecheck": "prisma generate && prisma generate --config prisma.admin.config.ts && tsc -p tsconfig.json --noEmit",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "start:admin": "node dist/admin-main.js",
    "prisma:pull:admin": "prisma db pull --config prisma.admin.config.ts",
    "test:contract-admin": "vitest run --config vitest.contract-admin.config.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/schedule": "^12.0.4",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "http-proxy-middleware": "^4.2.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "redis": "^6.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "type": "module"
}
