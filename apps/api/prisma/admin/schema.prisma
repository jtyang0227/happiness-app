generator client {
  provider     = "prisma-client"
  output       = "../../src/generated/admin-prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model achievements {
  id            BigInt   @id @default(autoincrement())
  created_at    DateTime @db.Timestamp(6)
  display_order Int
  location      String?  @db.VarChar(100)
  member_id     BigInt
  organizer     String?  @db.VarChar(100)
  title         String   @db.VarChar(200)
  type          String   @db.VarChar(20)
  url           String?  @db.VarChar(500)
  year_month    String?  @db.VarChar(7)
}

model admin_activity_logs {
  id          BigInt   @id @default(autoincrement())
  action      String   @db.VarChar(100)
  admin_id    BigInt?
  admin_name  String?  @db.VarChar(100)
  created_at  DateTime @db.Timestamp(6)
  details     String?
  target_id   BigInt?
  target_type String?  @db.VarChar(50)

  @@index([created_at], map: "idx_admin_activity_logs_created_at")
}

model admin_member_notes {
  id         BigInt   @id @default(autoincrement())
  admin_id   BigInt?
  admin_name String?  @db.VarChar(100)
  content    String
  created_at DateTime @db.Timestamp(6)
  member_id  BigInt

  @@index([member_id], map: "idx_admin_member_notes_member")
}

model admin_privacy_access_logs {
  id                BigInt   @id @default(autoincrement())
  accessed_at       DateTime @db.Timestamp(6)
  action            String   @db.VarChar(20)
  admin_id          BigInt?
  admin_name        String?  @db.VarChar(100)
  detail            String?  @db.VarChar(500)
  hash              String   @db.VarChar(64)
  ip_address        String?  @db.VarChar(45)
  prev_hash         String?  @db.VarChar(64)
  reason            String?  @db.VarChar(300)
  subject_count     Int?
  subject_member_id BigInt?

  @@index([accessed_at], map: "idx_privacy_logs_accessed_at")
  @@index([subject_member_id], map: "idx_privacy_logs_subject")
}

model banners {
  id            BigInt    @id @default(autoincrement())
  created_at    DateTime  @db.Timestamp(6)
  display_order Int
  ends_at       DateTime? @db.Timestamp(6)
  image_url     String    @db.VarChar(500)
  is_active     Boolean
  link_url      String?   @db.VarChar(500)
  starts_at     DateTime? @db.Timestamp(6)
  title         String    @db.VarChar(100)
  updated_at    DateTime  @db.Timestamp(6)
}

model boards {
  id         BigInt   @id @default(autoincrement())
  count      Int
  created_at DateTime @db.Timestamp(6)
  title      String   @db.VarChar(255)
  updated_at DateTime @db.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bookings {
  id                                        BigInt   @id @default(autoincrement())
  budget                                    String?  @db.VarChar(255)
  client_name                               String?  @db.VarChar(50)
  created_at                                DateTime @db.Timestamp(6)
  message                                   String?
  rejected_reason                           String?
  shoot_date                                DateTime @db.Date
  shoot_location                            String?  @db.VarChar(200)
  shoot_type                                String?  @db.VarChar(50)
  status                                    String   @db.VarChar(20)
  updated_at                                DateTime @db.Timestamp(6)
  client_id                                 BigInt?
  photographer_id                           BigInt?
  members_bookings_photographer_idTomembers members? @relation("bookings_photographer_idTomembers", fields: [photographer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk5xoo2fato6truo0dig4bijdqg")
  members_bookings_client_idTomembers       members? @relation("bookings_client_idTomembers", fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkdrd192k5f0i7qirf0dg71s9yy")

  @@index([shoot_date, status], map: "idx_bookings_shoot_date_status")
}

model client_brands {
  id            BigInt   @id @default(autoincrement())
  created_at    DateTime @db.Timestamp(6)
