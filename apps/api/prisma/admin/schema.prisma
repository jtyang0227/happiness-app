  updated_at                                 DateTime                @db.Timestamp(6)
  verified_at                                DateTime?               @db.Timestamp(6)
  bookings_bookings_photographer_idTomembers bookings[]              @relation("bookings_photographer_idTomembers")
  bookings_bookings_client_idTomembers       bookings[]              @relation("bookings_client_idTomembers")
  contents                                   contents[]
