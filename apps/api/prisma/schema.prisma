generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model achievements {
  id            BigInt   @id @default(autoincrement())
  created_at    DateTime @db.Timestamp(6)
  display_order Int
  location      String?  @db.VarChar(100)
  member_id     BigInt
  organizer     String?  @db.VarChar(100)
