  target_id     BigInt?
  target_type   String?  @db.VarChar(20)
  visitor_token String?  @db.VarChar(32)

  @@index([created_at], map: "idx_analytics_created_at")
  @@index([member_id, event_type], map: "idx_analytics_member_type")
  @@index([member_id, event_type, created_at], map: "idx_analytics_member_type_created")
  @@index([target_type, target_id, event_type], map: "idx_analytics_target")
  @@index([visitor_token, created_at], map: "idx_analytics_visitor_token")
}

