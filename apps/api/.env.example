# apps/api (NestJS) — 실제 값은 .env(커밋 금지) 또는 배포 서비스 변수에
DATABASE_URL="postgresql://user:pass@host:5432/db"   # Spring과 같은 DB
REDIS_URL="redis://localhost:6379"                   # Spring과 같은 Redis (없으면 토큰 회전·로그아웃 블랙리스트를 건너뜀)
JWT_SECRET=""                                        # Spring과 반드시 같은 값 — 같아야 토큰이 서로 통한다
LEGACY_API_URL="http://localhost:8080"               # 아직 옮기지 않은 경로를 넘길 Spring 주소
CORS_ALLOWED_ORIGINS="http://localhost:3000"
PORT=8090
NODE_ENV=development                                 # production이면 공개 기본 JWT 키를 거부
# APP_CLIENT_IP_HEADER=CF-Connecting-IP

# 배치(@nestjs/schedule — 납품 만료·예약 만료·약속 완료·모임 상태 전환). 비우면 LEGACY_API_URL이 있을 때 꺼짐(Spring이 같은 DB에서 돌리므로)
# 컷오버에서 Spring을 끌 때 true. 수동 실행: node scripts/run-batch.mjs <deliveries|bookings|meets|gatherings|all>
BATCH_ENABLED=

# ── 어드민 진입점(node dist/admin-main.js — happiness-admin Spring 대체, PLANNING 4-1) ──
ADMIN_PORT=8091
ADMIN_DB_SCHEMA=admin                               # Spring 어드민 DB_SCHEMA와 같은 값(기본 admin — 앱 public과 별도 표)
# ADMIN_DATABASE_URL=                               # 비우면 DATABASE_URL. db pull 때만 "?schema=admin"을 붙인다
ADMIN_JWT_SECRET=""                                 # Spring 어드민 JWT_SECRET과 같은 값(앱 JWT_SECRET과 다름). production이면 필수
ADMIN_JWT_EXPIRATION=28800                          # 초
ADMIN_CORS_ALLOWED_ORIGINS="http://localhost:3001"  # 어드민 프론트 도메인
PRIVACY_ENCRYPTION_KEY=""                           # Base64 32바이트(AES-256-GCM) — Spring 어드민과 같은 값이어야 기존 암호문을 읽는다

# SNAPDAY 공휴일 가져오기 — 공공데이터포털 "한국천문연구원_특일 정보" 서비스키(없으면 관리자 수동 등록)
HOLIDAY_API_KEY=
